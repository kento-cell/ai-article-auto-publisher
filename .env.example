# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_PATH=./config/credentials.json
GOOGLE_SHEET_ID=your_sheet_id_here

# Google Sheets URL（Gmail通知のリンク用）
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit

# note API
NOTE_API_TOKEN=your_note_token_here

# Zenn GitHub
ZENN_REPO_PATH=/path/to/your/zenn-repo

# Slack Bot（遠隔操作 + 通知）
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_NAME=ai-publisher
SLACK_ALLOWED_USERS=U0123456789  # あなたのSlackユーザーID（カンマ区切りで複数可）
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Gmail通知
GMAIL_SENDER=your_gmail@gmail.com
GMAIL_RECIPIENT=your_email@example.com

# Discord Bot（遠隔操作用）
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_NAME=ai-publisher

# Chrome Profile（Selenium用）
CHROME_PROFILE_PATH=/path/to/chrome/profile

# Ollama（ローカルLLM）
OLLAMA_API_URL=http://localhost:11434

# 画像API（著作権安全な素材取得、両方オプション）
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# ChatGPT 画像生成 CDP attach (Brave を --remote-debugging-port=9222 で起動した状態で接続)
# このフラグを設定すると Brave を完全停止せずに ChatGPT 画像生成パイプラインを使える。
# Brave 起動: scripts/launch_brave_cdp.bat
CHATGPT_CDP_PORT=9222
