# 収集設定
collection:
  zenn:
    sources:
      - arxiv
      - google_research
      - anthropic_blog
      - openai_blog
      - hackernews
    frequency: daily
    time: "22:00"
    max_articles: 10

  note:
    sources:
      - reddit
      - twitter
      - youtube
      - tiktok
      - google_trends
      - product_hunt
    frequency: daily
    time: "22:00"
    max_articles: 20

# 生成設定
generation:
  zenn:
    articles_per_week: 2
    min_quality_score: 60  # 7軸70点満点中
    target_word_count:
      min: 2500
      max: 3500

  note:
    articles_per_week: 1
    min_quality_score: 45  # 7軸70点満点中
    target_word_count:
      min: 2500
      max: 3500
    enable_paid: true

# トークン管理
token_management:
  weekly_limit: 2000000  # 2M tokens
  buffer_percentage: 50  # 50%はバッファ確保
  alert_threshold: 80    # 80%で警告

# 有料化設定（note）
pricing:
  thresholds:
    free: 0
    tier1: 700      # ¥300
    tier2: 1000     # ¥500
    tier3: 1500     # ¥980
    tier4: 2000     # ¥1,980

  prices:
    tier1: 300
    tier2: 500
    tier3: 980
    tier4: 1980

# 画像・ビジュアル設定
visuals:
  image_sources:
    - unsplash
    - pexels
  hero_image: true
  min_visual_elements: 3          # 記事あたり最低視覚要素数
  max_chars_without_visual: 800   # この文字数を超えたら視覚ブレイク挿入
  allowed_licenses:
    - CC0
    - "Unsplash License"
    - "Pexels License"
    - AI-generated
    - self-created
  attribution_required: true       # CC0でも帰属表示する

# リッチテキスト設定
rich_text:
  zenn:
    callout_style: ":::message"
    toggle_style: ":::details"
    enable_toc: true
  note:
    callout_style: "> **💡**"
    toggle_style: "<details>"
    enable_toc: true

# マルチエージェント設定
agents:
  max_revision_cycles: 2          # Writer↔Critic 最大修正回数
  require_human_approval: true     # 投稿前に人間承認必須
  min_source_credibility_tier: 2   # 核心主張に必要な最低ソースティア
  min_independent_sources: 3       # 主要主張あたりの独立ソース数
  structure_rotation: true
  available_structures:
    - standard
    - tutorial
    - comparison
    - deep_dive
    - qa

# エビデンス要件
evidence:
  citation_required: true
  screenshot_min_count: 5  # 検証系記事
  source_credibility_tiers:
    tier1:
      - academic_papers
      - official_docs
      - government_data
    tier2:
      - major_tech_blogs
      - reputable_news
    tier3:
      - community_posts
      - personal_blogs
    tier4:
      - anonymous_sources
      - unverified_claims
  forbidden_phrases:
    # 架空アンケート/調査主張。2026-06-10 旧 _TITLE_BRACKETS 由来の
    # 「【100人に聞いた】」が zenn scrap に公開された実害事故。アンケート
    # 実施の事実がない記事でこの主張は捏造 (bracket list からも除去済み)。
    - "\\d+\\s*人に(?:聞いた|訊いた|アンケート)"
    # 2026-07-13 事故#22: 内部 knowledge-topic URI / 「媒体名」placeholder
    # が出典として note 3本の本文に流出 (うち有料2本)。sanitizer で除去
    # されるが、3箇所同期 (forbidden_phrases + _PUBLISH_DENY) の最終防衛線。
    - "(?i)knowledge[-_]topic://"
    - "出典\\s*[:：][\\s*＊]*媒体名"
    # 2026-07-14 事故#24: ¥500記事が「科学が証明した」を裏付けゼロで主張。
    # 科学的証明の断定は検証不能なので deny (3箇所同期)。
    - "科学(?:的に)?\\s*[がはに]?\\s*証明(?:した|された|済み)"
    - "月.*万円.*稼いだ"
    - "誰でも.*稼げる"
    - "簡単.*収益"
    # ハルシネ対策: "〇〇氏/さんの{SNS}投稿" という架空前提パターンは
    # 一律で落とす。2026-04に習近平/妻夫木聡/李在明/メッツで同一パターンが
    # 発生し、公開→訂正コストが大きかったため禁止フレーズに登録する。
    # フィクション扱いでも note 読者は誤認しやすい。
    # 招待制・新興SNS (Bluesky/Threads/Mastodon) のみ禁止。
    # X/Instagram/Facebook は公式認証済みが多く引用検証可能なので除外。
    - "氏の\\s*(?:Bluesky|Threads|Mastodon)\\s*投稿"
    - "さんの\\s*(?:Bluesky|Threads|Mastodon)\\s*投稿"
    - "(?:Bluesky|Threads|Mastodon)\\s*投稿が話題"
    - "(?:Bluesky|Threads|Mastodon)\\s*投稿を徹底"
    - "(?:Bluesky|Threads|Mastodon)\\s*投稿から徹底"
    - "(?:Bluesky|Threads|Mastodon)\\s*投稿から読み解"
    - "架空の\\s*URL"   # 「(架空のURL)」系のAI自白
    - "Dr\\.\\s*X"      # 未同定の引用形式「Dr. X」
    # 架空イベント/架空SNSバズ検知 (2026-04-22 Vogue Korea記事で観測)
    - "#[\\w一-龯ぁ-ゔァ-ヴ]+[^\\n]{0,5}がトレンド入り"
    - "ハッシュタグ[^\\n]{0,35}がトレンド入り"
    - "がトレンド入りし[、。]"
    - "大きな話題を呼んでいます"
    - "議論を呼んで(?:い|います)"
    - "多くのメディアが[^\\n]{0,35}特集"
    - "賛否両論が[^\\n]{0,15}交錯"
    # プロンプト残留 placeholder (2026-04-23 花澤香菜/令和ロマン事故)
    - "ここに入力"
    - "実際には[^\\n]{0,30}URLを"
    - "URLは記載しません"
    # 伏字 + 業態語の組合せ (2026-05-07 一人飯記事で○○寿司/××焼鳥/
    # □□ラーメン/△△バルが全店伏字で公開された実害事故)。
    - "(?:〇〇|◯◯|○○|△△|××|□□|■■)(?:寿司|寿し|鮨|焼鳥|やきとり|ラーメン|つけ麺|バル|バー|ビストロ|食堂|酒場|割烹|蕎麦|そば|うどん|カレー|カフェ|喫茶|ベーカリー|パン屋?|スイーツ|和菓子|洋菓子|焼肉|鉄板|串カツ|串揚げ|天ぷら|うなぎ|もんじゃ|お好み焼|ピザ|フレンチ|イタリアン|中華|韓国料理|タイ料理|薬膳|ビアガーデン|居酒屋|ホルモン|ジビエ|ステーキ|定食)"
    - "(?:〇〇|◯◯|○○|△△|××|□□|■■)[一-龯ぁ-ゔァ-ヶー]{0,6}店(?![名称])"
    - "\\*\\*[〇◯○△×□■]{2,}"
    - "「[〇◯○△×□■]{2,}[^」]{0,16}」(?:が|は|を|に|で|と|の)"
    # 仮名/架空/仮称 markers (2026-05-08 「東京特定エリア…」記事で発見)
    - "（\\s*(?:仮名|仮称|架空|フィクション)\\s*）"
    - "\\(\\s*(?:仮名|仮称|架空|フィクション)\\s*\\)"
    - "(?:店|店舗|ブランド|会社|企業|施設)[\\s名「]{0,4}(?:仮名|仮称|架空)"
    # ―― や ‥ を伏字代わりに使うパターン
    - "(?:ーー|――|‥‥|……)(?:寿司|寿し|鮨|焼鳥|やきとり|ラーメン|バル|食堂|酒場|割烹|カフェ|焼肉|居酒屋)"
    # AI 生成開示 footer (2026-05-07 + 2026-05-08 拡充: 「AI が構成」変種)
    - "本記事は[^\\n]{0,20}(?:AI|ChatGPT|Claude|Gemini|GPT|生成AI|人工知能)[^\\n]{0,40}(?:生成|作成|執筆|書き起こ|構成|編集)"
    - "本記事の[^\\n]{0,30}(?:AI|ChatGPT|Claude|Gemini|GPT|生成AI|人工知能)[^\\n]{0,40}(?:生成|作成|執筆|書き起こ|構成|編集)"
    - "(?:AI|ChatGPT|Claude|Gemini|GPT)\\s*(?:による|が)\\s*(?:自動)?(?:生成|作成|執筆|構成|編集)"
    - "AIによって(?:生成|作成|執筆|構成|編集|自動生成)された"
    - "本記事の[^\\n]{0,20}(?:正確性|最新性|内容)を保証(?:するもの|いたしません)"
    - "免責事項[:：]?\\s*本記事[^\\n]{0,30}(?:正確性|参考|個人)"
    - "※\\s*(?:AI|ChatGPT|Claude|Gemini|GPT|生成AI)[^\\n]{0,15}(?:生成|作成|執筆|構成|編集)(?:記事|コンテンツ)"
    - "(?:Generated|Written|Created|Produced)\\s+by\\s+(?:AI|ChatGPT|Claude|GPT|Gemini)"
    - "This\\s+article\\s+(?:was|is)\\s+(?:generated|written|created)\\s+by\\s+(?:an?\\s+)?(?:AI|ChatGPT|Claude|GPT)"
    # A/B/C 記号命名 (2026-04-23 ダルゴナ/花澤香菜事故)
    - "(?:専門店|ブランド|ショップ|サロン|クリニック|カフェ|店舗|スポット|メーカー|スタジオ)[ABCＡＢＣ](?![a-zA-Z0-9])"
    # 2026-05-14 Stage 2 of note redesign: AI-generated text detectors
    # (note公式は2024年にAI量産19万ページのインデックス削減を実施。
    # blog-auto-ai.jp参照)
    # (1) 接続詞濫用 — 「そのため」「つまり」「一方で」が 3回以上連続
    # 2026-05-15 maintenance: 旧 regex `そのため(?:[^。]{0,80}。[^そ]{0,300}){2,}そのため` は
    # nested quantifier で gemma4:e4b の 7-8k char 出力に対し
    # catastrophic backtracking → Phase 2 で 30 min hang (run 19+20)。
    # 1 段 quantifier の atomic 形に書換、線形時間保証。意図 (3 連発検出) は不変。
    - "(?:そのため[^。]{0,400}。\\s*){3,}"
    - "(?:つまり[^。]{0,400}。\\s*){3,}"
    - "(?:一方で[^。]{0,400}。\\s*){3,}"
    # (2) 横棒 ── (Em-dash / 二重ハイフン) を 3 連 — AI 記事の典型装飾
    - "──[^─]*──[^─]*──"
    # (3) AI が "段階的に説明" を律儀にやる文末
    - "次に[、，]?[^。]{0,40}について(?:解説|説明|紹介)します"
    - "まず[、，]?[^。]{0,40}について(?:解説|説明|紹介)します"

  # グルメ・スポット紹介ルール
  gourmet_rules:
    chain_store_policy: "禁止"  # チェーン店は紹介しない
    target_type: "個人店・隠れた名店のみ"
    # チェーン店名リスト（これらが記事に含まれていたら警告）
    chain_blacklist:
      - "スターバックス"
      - "ドトール"
      - "タリーズ"
      - "コメダ珈琲"
      - "サンマルクカフェ"
      - "鳥貴族"
      - "串カツ田中"
      - "磯丸水産"
      - "塚田農場"
      - "白木屋"
      - "魚民"
      - "笑笑"
      - "和民"
      - "ワタミ"
      - "牛角"
      - "かっぱ寿司"
      - "スシロー"
      - "くら寿司"
      - "はま寿司"
      - "サイゼリヤ"
      - "ガスト"
      - "デニーズ"
      - "ジョナサン"
      - "吉野家"
      - "松屋"
      - "すき家"
      - "マクドナルド"
      - "モスバーガー"
      - "ケンタッキー"
      - "Starbucks"
      - "McDonald's"
