# 収集設定
collection:
  zenn:
    sources:
      - arxiv
      - google_research
      - anthropic_blog
      - openai_blog
      - hackernews
    frequency: daily
    time: "22:00"
    max_articles: 10

  note:
    sources:
      - reddit
      - twitter
      - youtube
      - tiktok
      - google_trends
      - product_hunt
    frequency: daily
    time: "22:00"
    max_articles: 20

# 生成設定
generation:
  zenn:
    articles_per_week: 1
    min_quality_score: 60  # 7軸70点満点中
    target_word_count:
      min: 2500
      max: 3500

  note:
    articles_per_week: 1
    min_quality_score: 45  # 7軸70点満点中
    target_word_count:
      min: 2500
      max: 3500
    enable_paid: true

# トークン管理
token_management:
  weekly_limit: 2000000  # 2M tokens
  buffer_percentage: 50  # 50%はバッファ確保
  alert_threshold: 80    # 80%で警告

# 有料化設定（note）
pricing:
  thresholds:
    free: 0
    tier1: 700      # ¥300
    tier2: 1000     # ¥500
    tier3: 1500     # ¥980
    tier4: 2000     # ¥1,980

  prices:
    tier1: 300
    tier2: 500
    tier3: 980
    tier4: 1980

# 画像・ビジュアル設定
visuals:
  image_sources:
    - unsplash
    - pexels
  hero_image: true
  min_visual_elements: 3          # 記事あたり最低視覚要素数
  max_chars_without_visual: 800   # この文字数を超えたら視覚ブレイク挿入
  allowed_licenses:
    - CC0
    - "Unsplash License"
    - "Pexels License"
    - AI-generated
    - self-created
  attribution_required: true       # CC0でも帰属表示する

# リッチテキスト設定
rich_text:
  zenn:
    callout_style: ":::message"
    toggle_style: ":::details"
    enable_toc: true
  note:
    callout_style: "> **💡**"
    toggle_style: "<details>"
    enable_toc: true

# マルチエージェント設定
agents:
  max_revision_cycles: 2          # Writer↔Critic 最大修正回数
  require_human_approval: true     # 投稿前に人間承認必須
  min_source_credibility_tier: 2   # 核心主張に必要な最低ソースティア
  min_independent_sources: 3       # 主要主張あたりの独立ソース数
  structure_rotation: true
  available_structures:
    - standard
    - tutorial
    - comparison
    - deep_dive
    - qa

# エビデンス要件
evidence:
  citation_required: true
  screenshot_min_count: 5  # 検証系記事
  source_credibility_tiers:
    tier1:
      - academic_papers
      - official_docs
      - government_data
    tier2:
      - major_tech_blogs
      - reputable_news
    tier3:
      - community_posts
      - personal_blogs
    tier4:
      - anonymous_sources
      - unverified_claims
  forbidden_phrases:
    - "月.*万円.*稼いだ"
    - "誰でも.*稼げる"
    - "簡単.*収益"

  # グルメ・スポット紹介ルール
  gourmet_rules:
    chain_store_policy: "禁止"  # チェーン店は紹介しない
    target_type: "個人店・隠れた名店のみ"
    # チェーン店名リスト（これらが記事に含まれていたら警告）
    chain_blacklist:
      - "スターバックス"
      - "ドトール"
      - "タリーズ"
      - "コメダ珈琲"
      - "サンマルクカフェ"
      - "鳥貴族"
      - "串カツ田中"
      - "磯丸水産"
      - "塚田農場"
      - "白木屋"
      - "魚民"
      - "笑笑"
      - "和民"
      - "ワタミ"
      - "牛角"
      - "かっぱ寿司"
      - "スシロー"
      - "くら寿司"
      - "はま寿司"
      - "サイゼリヤ"
      - "ガスト"
      - "デニーズ"
      - "ジョナサン"
      - "吉野家"
      - "松屋"
      - "すき家"
      - "マクドナルド"
      - "モスバーガー"
      - "ケンタッキー"
      - "Starbucks"
      - "McDonald's"
